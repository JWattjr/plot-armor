{
  "name": "plot-armor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3134",
    "build": "next build",
    "start": "next start --port 3134",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:contract": "python scripts/test_contracts.py",
    "release": "python scripts/release.py",
    "settle": "python scripts/release.py settle",
    "verify:proof": "python scripts/verify_proof.py",
    "verify": "python scripts/verify_proof.py && python scripts/audit_links.py",
    "lint:contract": "python scripts/lint_contracts.py"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.6",
    "@fontsource/dm-sans": "5.2.8",
    "genlayer-js": "1.1.8",
    "lucide-react": "0.548.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8"
  }
}